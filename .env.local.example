# No environment file is required for the sample at /demo.
# Configure provider API keys and base URLs in the application UI.
# ANTHROPIC_API_KEY / OPENAI_API_KEY are not loaded by the current key store.

# Electron server port (default: 3456)
# CHAINMIND_PORT=3456

# Optional token for local privileged API tools.
# Electron generates its own token when this is unset.
# Never prefix it with NEXT_PUBLIC_ or commit a real value.
# CHAINMIND_EXEC_TOKEN=replace-with-a-random-local-secret

# Enable hardware acceleration only when appropriate for your device.
# CHAINMIND_SOFTWARE_RENDERING=0

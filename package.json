{
  "name": "chainmind",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first workspace for multi-agent discussions, streaming chat, and human-guided decisions.",
  "author": "ChainMind Team",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint electron/ lib/ stores/ app/ components/",
    "rebuild:node-native": "npm rebuild better-sqlite3 --build-from-source --silent",
    "rebuild:electron-native": "npm rebuild better-sqlite3",
    "test": "vitest --run",
    "audit:security": "npm --registry=https://registry.npmjs.org/ audit",
    "audit:security:fix": "npm --registry=https://registry.npmjs.org/ audit fix",
    "electron:dev": "electron .",
    "electron:fix-native": "npm rebuild better-sqlite3",
    "electron:build": "next build && electron-builder",
    "electron:pack": "next build && electron-builder --dir",
    "typecheck": "tsc --noEmit",
    "test:ci": "vitest run",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@orama/orama": "^3.1.6",
    "@types/lodash-es": "^4.17.12",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "13.0.3",
    "chokidar": "^4.0.3",
    "cmdk": "^1.1.1",
    "electron-updater": "^6.8.3",
    "html-to-image": "^1.11.13",
    "idb-keyval": "^6.2.1",
    "js-tiktoken": "^1.0.21",
    "jsonwebtoken": "^9.0.2",
    "katex": "^0.16.39",
    "lodash-es": "^4.17.23",
    "lucide-react": "^0.577.0",
    "mermaid": "^11.13.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "reactflow": "^11.11.4",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.3",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^3.23.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.2",
    "eslint": "^9.39.3",
    "postcss": "8.5.28",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "vitest": "4.1.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.chainmind.app",
    "productName": "ChainMind",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "lib/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app/.next/standalone"
      },
      {
        "from": ".next/static",
        "to": "app/.next/standalone/.next/static"
      },
      {
        "from": "public",
        "to": "app/.next/standalone/public"
      }
    ],
    "npmRebuild": false,
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "chainmind",
        "repo": "chainmind-releases",
        "releaseType": "release"
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "darkModeSupport": true
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ]
    }
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/djblack1209-coder/ChainMind.git"
  },
  "engines": {
    "node": ">=22.12 <23"
  }
}
